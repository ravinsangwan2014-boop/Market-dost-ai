# Market Dost AI Configuration

# Silver Portfolio Configuration
SILVER_KG=28
SILVER_AVG_COST_INR_PER_KG=171000

# Timezone
TIMEZONE=Asia/Kolkata

# API Keys
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
TRADING_ECONOMICS_API_KEY=your_trading_economics_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Watcher Configuration (for worker.py)
WATCHER_INTERVAL_MINUTES=5
ECONOMIC_CALENDAR_MIN_IMPORTANCE=2
CALENDAR_MODE=trading_economics

# Google Calendar Integration (required when CALENDAR_MODE=google)
# Required in all Google modes
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ALERT_LEAD_MINUTES=30
GOOGLE_CALENDAR_LOOKBACK_MINUTES=15
GOOGLE_CALENDAR_LOOKAHEAD_MINUTES=180

# Auth option A (public calendar): API key
GOOGLE_API_KEY=

# Auth option B (private calendar): OAuth refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional local verification mode (does not send Telegram message)
TELEGRAM_DRY_RUN=0
